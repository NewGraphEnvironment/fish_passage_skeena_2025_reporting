        <default field="photo_extra2_tag" applyOnUpdate="0" expression=""/>
        <default field="link_method_phase1" applyOnUpdate="0" expression="'&lt;a href=&quot;https://www2.gov.bc.ca/assets/gov/environment/natural-resource-stewardship/land-based-investment/forests-for-tomorrow/field-assessment-for-determining-fish-passage-status-of-cbs.pdf/&quot;>Link to Methods for Fish Passage Assessment&lt;/a>'"/>
